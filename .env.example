# CopilotCA — root docker-compose environment knobs (reference/documentation).
#
# docker-compose.yml sets these values inline for local dev, so you do NOT need a
# root .env to run the stack. This file documents the compose env surface and the
# values to change when deploying to real hosts.
#
# Per-app secrets live in each app's own .env (git-ignored):
#   BE/.env            (copy from BE/.env.example)
# Front-end build/runtime URLs are set by compose (below) or per-app .env.

# --- Compose service credentials (Postgres) ---
# Used for the db service AND baked into the backend DATABASE_URL. Keep the three
# in sync; change all for anything but local dev.
POSTGRES_USER=copilotca
POSTGRES_PASSWORD=copilotca
POSTGRES_DB=copilotca

# --- Backend wiring (compose overrides BE/.env with these) ---
# In-compose service hostnames (db / redis / kafka), not localhost.
DATABASE_URL=postgresql+asyncpg://copilotca:copilotca@db:5432/copilotca
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP=kafka:9092
# Comma-separated browser origins allowed to call the API cross-origin.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Front-end -> backend base URLs ---
# web-app (Vite: baked at build time).
VITE_API_BASE_URL=http://localhost:8000
